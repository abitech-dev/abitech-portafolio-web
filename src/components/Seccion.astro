---
interface Props {
  titulo: string;
  id?: string;
}

const { titulo, id } = Astro.props;
---

<section class="mt-12 first:mt-0" aria-labelledby={id}>
  <h2 id={id} class="mb-5 flex items-center gap-3 text-xl font-semibold">
    <span class="bg-acento h-6 w-1 rounded-full" aria-hidden="true"></span>
    {titulo}
  </h2>
  <slot />
</section>
