---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import foto from "@/assets/foto-perfil.jpg";
import BotonTema from "@/components/islands/BotonTema.vue";
import Navegacion from "@/components/Navegacion.astro";
import { datosDe, textosDe } from "@/i18n/idioma";
import { idiomaDeLaRuta, rutaEnOtroIdioma } from "@/i18n/rutas";

const idioma = idiomaDeLaRuta(Astro.url.pathname);
const { sitio } = textosDe(idioma);
const { name, label, email, location, profiles } = datosDe(idioma).basics;
const ICONOS: Record<string, string> = {
  LinkedIn: "lucide:linkedin",
  GitHub: "lucide:github",
};
---

<aside class="border-borde bg-superficie/90 sticky top-2 z-40 flex flex-col gap-5 rounded-lg border p-3 shadow-sm backdrop-blur lg:top-8 lg:p-6">
  <div class="flex items-center gap-3 lg:flex-col lg:gap-4 lg:text-center">
    <Image
      src={foto}
      alt={sitio.fotoDe(name)}
      width={320}
      height={320}
      loading="eager"
      class="border-borde size-12 shrink-0 rounded-md border object-cover lg:size-40 lg:rounded-lg"
    />
    <div class="min-w-0 flex-1">
      <p class="truncate font-bold lg:text-xl lg:whitespace-normal">{name}</p>
      <p class="text-acento truncate text-xs lg:mt-1 lg:text-sm lg:whitespace-normal">
        {label}
      </p>
    </div>
    <button
      type="button"
      data-menu-boton
      aria-expanded="false"
      aria-controls="menu-movil"
      class="border-borde text-texto inline-flex shrink-0 items-center gap-2 rounded-md border px-3 py-2 text-sm lg:hidden"
    >
      <Icon name="lucide:menu" class="size-4" aria-hidden="true" />
      {sitio.menu}
    </button>
  </div>

  <div id="menu-movil" class="menu-movil flex flex-col gap-5">
    <p class="text-tenue flex items-center gap-2 text-sm lg:justify-center">
      <Icon name="lucide:map-pin" class="size-4" aria-hidden="true" />
      {location.city}, {sitio.pais}
    </p>

    <ul class="flex gap-2 lg:justify-center" aria-label={sitio.perfiles}>
      {profiles.map((perfil) => (
        <li>
          <a
            href={perfil.url}
            rel="me noopener"
            target="_blank"
            aria-label={perfil.network}
            class="border-borde text-tenue hover:text-acento inline-flex rounded-md border p-2 transition-colors"
          >
            <Icon
              name={ICONOS[perfil.network] ?? "lucide:external-link"}
              class="size-4"
            />
          </a>
        </li>
      ))}
      <li>
        <a
          href={`mailto:${email}`}
          data-umami-event="escribir-correo"
          aria-label={sitio.correo}
          class="border-borde text-tenue hover:text-acento inline-flex rounded-md border p-2 transition-colors"
        >
          <Icon name="lucide:mail" class="size-4" />
        </a>
      </li>
      <li>
        <BotonTema client:load etiqueta={sitio.temaOscuro}>
          <Icon slot="claro" name="lucide:moon" class="size-4" />
          <Icon slot="oscuro" name="lucide:sun" class="size-4" />
        </BotonTema>
      </li>
      <li>
        <a
          href={rutaEnOtroIdioma(Astro.url.pathname)}
          data-otro-idioma
          hreflang={sitio.otroIdioma.codigo}
          lang={sitio.otroIdioma.codigo}
          class="border-borde text-tenue hover:text-acento inline-flex h-full items-center rounded-md border px-2 text-xs font-semibold transition-colors"
        >
          {sitio.otroIdioma.etiqueta}
        </a>
      </li>
    </ul>

    <Navegacion />
  </div>
</aside>

<script>
  import { rutaEnOtroIdioma } from "@/i18n/rutas";

  // La tarjeta cambia al cambiar de idioma, así que se busca en cada evento.
  const elementos = () => ({
    boton: document.querySelector<HTMLButtonElement>("[data-menu-boton]"),
    menu: document.getElementById("menu-movil"),
  });

  function abrirMenu(isAbierto: boolean): void {
    const { boton, menu } = elementos();
    boton?.setAttribute("aria-expanded", String(isAbierto));
    menu?.toggleAttribute("data-abierto", isAbierto);
  }

  document.addEventListener("click", (evento) => {
    const boton = (evento.target as Element).closest("[data-menu-boton]");
    if (boton) abrirMenu(boton.getAttribute("aria-expanded") !== "true");
  });
  document.addEventListener("keydown", (evento) => {
    const { boton, menu } = elementos();
    if (evento.key === "Escape" && menu?.hasAttribute("data-abierto")) {
      abrirMenu(false);
      boton?.focus();
    }
  });
  document.addEventListener("astro:after-swap", () => abrirMenu(false));

  // El enlace al otro idioma apunta a la versión de la página actual.
  document.addEventListener("astro:page-load", () => {
    document
      .querySelector("[data-otro-idioma]")
      ?.setAttribute("href", rutaEnOtroIdioma(location.pathname));
  });
</script>
