---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import ChipDeTecnologia from "@/components/ChipDeTecnologia.astro";
import LogoDeProyecto from "@/components/LogoDeProyecto.astro";
import { textosDe } from "@/i18n/idioma";
import { idiomaDeLaRuta, rutaEn } from "@/i18n/rutas";
import { capturaDelProyecto } from "@/lib/imagenes";
import type { Proyecto } from "@/lib/trayectoria";

interface Props {
  proyecto: Proyecto;
  encabezado?: "h2" | "h3";
  hasCaptura?: boolean;
}

const {
  proyecto,
  encabezado: Encabezado = "h3",
  hasCaptura = false,
} = Astro.props;
const captura = hasCaptura ? capturaDelProyecto(proyecto.id) : undefined;
const idioma = idiomaDeLaRuta(Astro.url.pathname);
const { sitio, proyectos: t } = textosDe(idioma);
---

<article class="border-borde bg-superficie hover:border-acento flex h-full flex-col gap-3 overflow-hidden rounded-md border p-5 transition-colors">
  {captura && (
    <Image
      src={captura}
      alt={t.portadaDe(proyecto.name)}
      widths={[400, 720]}
      sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
      class="border-borde -mx-5 -mt-5 mb-1 aspect-[16/10] w-[calc(100%+2.5rem)] max-w-none border-b object-cover object-top"
    />
  )}
  <div class="flex items-center gap-3">
    <LogoDeProyecto id={proyecto.id} class="size-12" />
    <Encabezado class="font-semibold">
      <a
        href={rutaEn(idioma, `/proyectos/${proyecto.id}`)}
        class="hover:text-acento"
      >
        {proyecto.name}
      </a>
    </Encabezado>
  </div>
  <p class="text-tenue text-sm leading-relaxed">{proyecto.description}</p>
  <ul class="mt-auto flex flex-wrap gap-2" aria-label={t.tecnologias}>
    {proyecto.keywords.slice(0, 4).map((tecnologia) => (
      <ChipDeTecnologia tecnologia={tecnologia} class="px-2.5 py-0.5 text-xs" />
    ))}
  </ul>
  {proyecto.url && (
    <a
      href={proyecto.url}
      target="_blank"
      rel="noopener"
      class="text-acento inline-flex items-center gap-1 text-sm"
    >
      {t.verEnLinea}
      <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
      <span class="sr-only">
        {proyecto.name} ({sitio.otraPestana})
      </span>
    </a>
  )}
</article>
