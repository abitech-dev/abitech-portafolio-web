---
import { Icon } from "astro-icon/components";

interface Props {
  icono: string;
  class?: string | undefined;
}

const { icono, class: clase } = Astro.props;
---

<div
  class:list={[
    "border-borde bg-acento-suave text-acento grid shrink-0 place-items-center rounded-md border",
    clase,
  ]}
>
  <Icon is:inline name={icono} class="size-1/2" aria-hidden="true" />
</div>
