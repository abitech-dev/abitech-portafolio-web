---
import { Code } from "astro:components";
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import BotonCopiar from "@/components/islands/BotonCopiar.vue";
import LogoDeProyecto from "@/components/LogoDeProyecto.astro";
import { textosDe } from "@/i18n/idioma";
import { idiomaDeLaRuta } from "@/i18n/rutas";
import { logoDeTecnologia } from "@/lib/logos-de-tecnologias";
import { registroDelPaquete, type Proyecto } from "@/lib/trayectoria";

interface Props {
  paquete: Proyecto;
}

const { paquete } = Astro.props;
const idioma = idiomaDeLaRuta(Astro.url.pathname);
const { sitio, codigoAbierto } = textosDe(idioma);
const nombre = "package" in paquete ? paquete.package : undefined;
const repositorio = "repository" in paquete ? paquete.repository : undefined;
const registro = nombre ? registroDelPaquete(nombre) : undefined;
const detalle = await getEntry("paquetes", paquete.id);
if (!detalle) {
  throw new Error(`Falta src/content/paquetes/${paquete.id}.yaml.`);
}
const { lema, integra, datos, ejemplo } = detalle.data;
---

<article class="aparecer mt-6">
  <header>
    <div class="flex items-center gap-4">
      <LogoDeProyecto id={paquete.id} class="size-16" />
      <div class="min-w-0">
        <h1 class="font-display text-3xl font-bold break-words sm:text-4xl">
          {paquete.name}
        </h1>
        {nombre && <p class="text-tenue mt-1 font-mono text-sm">{nombre}</p>}
      </div>
    </div>
  </header>

  <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-12">
    <div class="flex min-w-0 flex-col">
      <p class="text-lg leading-snug sm:text-xl">{lema[idioma]}</p>

      <ul
        class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3"
        aria-label={codigoAbierto.integra}
      >
        {integra.map((servicio) => {
          const logo = logoDeTecnologia(servicio);
          return (
            <li class="inline-flex items-center gap-2 font-medium">
              {logo && (
                <Icon is:inline name={logo} class="size-7" aria-hidden="true" />
              )}
              {servicio}
            </li>
          );
        })}
      </ul>

      <dl class="border-borde mt-8 grid grid-cols-2 gap-y-5 border-t pt-6 sm:grid-cols-4">
        {datos.map((dato) => (
          <div class="flex flex-col-reverse">
            <dt class="text-tenue text-xs">{dato.etiqueta[idioma]}</dt>{" "}
            <dd class="font-display text-xl font-bold">{dato.valor[idioma]}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
        {repositorio && (
          <a
            href={repositorio}
            data-umami-event="abrir-paquete"
            data-umami-event-paquete={paquete.id}
            target="_blank"
            rel="noopener"
            class="group text-acento inline-flex w-fit items-center gap-2 font-semibold"
          >
            <Icon
              is:inline
              name="lucide:github"
              class="size-5"
              aria-hidden="true"
            />
            {codigoAbierto.verEnGithub}
            <Icon
              is:inline
              name="lucide:arrow-up-right"
              class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              aria-hidden="true"
            />
            <span class="sr-only">({sitio.otraPestana})</span>
          </a>
        )}
        {nombre && registro && (
          <a
            href={registro.url}
            data-umami-event={`abrir-${registro.nombre.toLowerCase()}`}
            data-umami-event-paquete={paquete.id}
            target="_blank"
            rel="noopener"
            class="group text-acento inline-flex w-fit items-center gap-2 font-semibold"
          >
            <Icon
              is:inline
              name={`simple-icons:${registro.nombre.toLowerCase()}`}
              class="size-5"
              aria-hidden="true"
            />
            {codigoAbierto.verEn} {registro.nombre}
            <Icon
              is:inline
              name="lucide:arrow-up-right"
              class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              aria-hidden="true"
            />
            <span class="sr-only">({sitio.otraPestana})</span>
          </a>
        )}
      </div>
    </div>

    <div class="min-w-0 self-center">
      <figure class="bg-superficie overflow-hidden rounded-lg shadow-sm">
        <figcaption class="text-tenue border-borde border-b px-5 py-2.5 font-mono text-xs">
          {ejemplo.archivo}
        </figcaption>
        <div class="ejemplo-de-codigo text-sm">
          <Code
            code={ejemplo.codigo}
            lang={ejemplo.lenguaje as "php"}
            themes={{
              light: "github-light-high-contrast",
              dark: "github-dark",
            }}
          />
        </div>
      </figure>
    </div>
  </div>

  <div class="mt-10">
    {nombre && registro && (
      <div>
        <p class="text-tenue text-xs font-semibold tracking-wide uppercase">
          {codigoAbierto.instalacion}
        </p>
        <div class="bg-superficie border-borde mt-2 flex items-center gap-3 rounded-lg border py-2 pr-2 pl-4">
          <p class="min-w-0 flex-1 font-mono text-sm leading-relaxed">
            <span class="text-tenue select-none" aria-hidden="true">
              ${" "}
            </span>
            {registro.comando} <span class="whitespace-nowrap">{nombre}</span>
          </p>
          <BotonCopiar
            client:idle
            texto={`${registro.comando} ${nombre}`}
            copiar={codigoAbierto.copiar}
            copiado={codigoAbierto.copiado}
            isCompacto
            data-umami-event="copiar-instalacion"
            data-umami-event-paquete={paquete.id}
          >
            <Icon
              is:inline
              slot="copiar"
              name="lucide:copy"
              class="size-4"
              aria-hidden="true"
            />
            <Icon
              is:inline
              slot="copiado"
              name="lucide:check"
              class="size-4"
              aria-hidden="true"
            />
          </BotonCopiar>
        </div>
      </div>
    )}
  </div>
</article>
