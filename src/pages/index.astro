---
import { Icon } from "astro-icon/components";

import Seccion from "@/components/Seccion.astro";
import TarjetaProyecto from "@/components/TarjetaProyecto.astro";
import resume from "@/data/resume.json";
import Base from "@/layouts/Base.astro";
import { persona } from "@/lib/datos-estructurados";
import { periodo } from "@/lib/fechas";
import { proyectosPorId } from "@/lib/trayectoria";

const DESTACADOS = ["tu-coach", "abitech-payments", "cred-plus", "yachacuy"];
const { basics, work, publications } = resume;
const actual = work[0];
const proyectos = proyectosPorId(resume, DESTACADOS);
const libro = publications[0];
---

<Base
  descripcion={basics.summary}
  datosEstructurados={persona(resume, Astro.site ?? new URL(Astro.url))}
>
  <h1 class="text-3xl font-bold sm:text-4xl">
    Hola, soy <span class="text-acento">{basics.name.split(" ")[0]}</span>
  </h1>
  <p class="mt-3 text-lg">{basics.label}.</p>
  <p class="text-tenue mt-4 max-w-prose leading-relaxed">{basics.summary}</p>

  {actual && (
    <Seccion titulo="En qué trabajo hoy" id="hoy">
      <p class="font-semibold">
        {actual.position}, {actual.name}
      </p>
      <p class="text-tenue font-mono text-xs">{periodo(actual.startDate)}</p>
      <p class="text-tenue mt-2">{actual.summary}</p>
    </Seccion>
  )}

  <Seccion titulo="Proyectos destacados" id="proyectos">
    <div class="grid gap-4 sm:grid-cols-2">
      {proyectos.map((proyecto) => (
        <TarjetaProyecto proyecto={proyecto} />
      ))}
    </div>
  </Seccion>

  {libro && (
    <Seccion titulo="Libro en curso" id="libro">
      <p class="font-semibold">{libro.name}</p>
      <p class="text-tenue mt-2">{libro.summary}</p>
    </Seccion>
  )}

  <Seccion titulo="¿Conversamos?" id="contacto">
    <a
      href="/contacto"
      class="bg-acento text-fondo inline-flex items-center gap-2 rounded-lg px-4 py-2 font-semibold"
    >
      Escríbeme
      <Icon name="lucide:send" class="size-4" aria-hidden="true" />
    </a>
  </Seccion>
</Base>
