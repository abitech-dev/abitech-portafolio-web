---
import { Icon } from "astro-icon/components";

import LineaDeTiempo from "@/components/LineaDeTiempo.astro";
import Seccion from "@/components/Seccion.astro";
import resume from "@/data/resume.json";
import Base from "@/layouts/Base.astro";
import { persona } from "@/lib/datos-estructurados";
import { mesYAnio, periodo } from "@/lib/fechas";
import { habilidadesPorCategoria } from "@/lib/trayectoria";

const { basics, work, education, certificates, skills, languages } = resume;

const experiencia = work.map((empleo) => ({
  titulo: empleo.position,
  lugar: empleo.name,
  periodo: periodo(
    empleo.startDate,
    "endDate" in empleo ? empleo.endDate : undefined,
  ),
  resumen: empleo.summary,
  logros: empleo.highlights,
}));

const formacion = education.map((estudio) => ({
  titulo: estudio.area,
  lugar: `${estudio.institution}, ${estudio.studyType}`,
  periodo: estudio.startDate
    ? periodo(estudio.startDate, estudio.endDate)
    : mesYAnio(estudio.endDate),
}));

const habilidades = habilidadesPorCategoria(skills);
---

<Base
  titulo="CV"
  descripcion={`Experiencia, formación, certificaciones y habilidades de ${basics.name}.`}
  datosEstructurados={persona(resume, Astro.site ?? new URL(Astro.url))}
>
  <h1 class="text-3xl font-bold">Currículum</h1>
  <p class="text-tenue mt-3 max-w-prose">
    Para recibir el CV en PDF, escríbeme a
    <a class="text-acento underline" href={`mailto:${basics.email}`}>
      {basics.email}
    </a>
    .
  </p>

  <Seccion titulo="Experiencia" id="experiencia">
    <LineaDeTiempo hitos={experiencia} />
  </Seccion>

  <Seccion titulo="Formación" id="formacion">
    <LineaDeTiempo hitos={formacion} />
  </Seccion>

  <Seccion titulo="Certificaciones" id="certificaciones">
    <ul class="grid gap-3 sm:grid-cols-2">
      {certificates.map((certificado) => (
        <li class="border-borde rounded-xl border p-4">
          <p class="font-semibold">{certificado.name}</p>
          <p class="text-tenue text-sm">
            {certificado.issuer}, {mesYAnio(certificado.date)}
          </p>
          {"url" in certificado && certificado.url && (
            <a
              href={certificado.url}
              target="_blank"
              rel="noopener"
              class="text-acento mt-1 inline-flex items-center gap-1 text-sm"
            >
              Verificar
              <Icon
                name="lucide:external-link"
                class="size-3.5"
                aria-hidden="true"
              />
              <span class="sr-only">
                {certificado.name} (abre en otra pestaña)
              </span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </Seccion>

  <Seccion titulo="Habilidades" id="habilidades">
    <dl class="grid gap-4 sm:grid-cols-2">
      {[...habilidades].map(([categoria, lista]) => (
        <div>
          <dt class="font-semibold">{categoria}</dt>
          <dd class="text-tenue mt-1 text-sm">
            {lista
              .map((h) => `${h.name} (${h.level.toLowerCase()})`)
              .join(", ")}
          </dd>
        </div>
      ))}
    </dl>
  </Seccion>

  <Seccion titulo="Idiomas" id="idiomas">
    <ul class="text-tenue">
      {languages.map((idioma) => (
        <li>
          {idioma.language}, {idioma.fluency.toLowerCase()}
        </li>
      ))}
    </ul>
  </Seccion>
</Base>
