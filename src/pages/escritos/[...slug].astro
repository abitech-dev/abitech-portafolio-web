---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";

import { textosDe } from "@/i18n/idioma";
import Base from "@/layouts/Base.astro";
import { escritosPublicados } from "@/lib/coleccion-escritos";
import { articulo } from "@/lib/datos-estructurados";
import { idDeEtiqueta, minutosDeLectura } from "@/lib/escritos";

export async function getStaticPaths() {
  return (await escritosPublicados()).map((escrito) => ({
    params: { slug: escrito.id },
    props: { escrito },
  }));
}

const { escrito } = Astro.props;
const { Content } = await render(escrito);
const { escritos: t } = textosDe("es");
const { titulo, descripcion, fecha, actualizado, tipo, etiquetas } =
  escrito.data;
const formato = new Intl.DateTimeFormat("es-PE", {
  dateStyle: "long",
  timeZone: "UTC",
});
---

<Base
  titulo={titulo}
  descripcion={descripcion}
  hasVersionEnIngles={false}
  nodos={[articulo(escrito.data, Astro.site ?? Astro.url, Astro.url)]}
>
  <a
    href="/escritos"
    class="text-tenue hover:text-acento inline-flex items-center gap-1 text-sm"
  >
    <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
    {t.volver}
  </a>

  <header class="aparecer mt-6 max-w-3xl">
    <p class="text-acento text-xs font-semibold tracking-wide uppercase">
      {tipo === "articulo" ? t.articulo : t.nota}
    </p>
    <h1 class="mt-2 text-3xl leading-tight font-bold sm:text-4xl">{titulo}</h1>
    <p class="text-tenue mt-4 text-lg leading-relaxed">{descripcion}</p>
    <p class="text-tenue mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <time datetime={fecha.toISOString().slice(0, 10)}>
        {formato.format(fecha)}
      </time>
      <span>{t.minutos(minutosDeLectura(escrito.body ?? ""))}</span>
    </p>
    <ul class="mt-3 flex flex-wrap gap-2" aria-label={t.etiquetas}>
      {etiquetas.map((etiqueta) => (
        <li>
          <a
            href={`/escritos/etiquetas/${idDeEtiqueta(etiqueta)}`}
            class="text-tenue hover:text-acento font-mono text-xs"
          >
            #{etiqueta}
          </a>
        </li>
      ))}
    </ul>
  </header>

  <div class="prose prose-lg dark:prose-invert prose-headings:font-display prose-a:text-acento prose-pre:rounded-md prose-pre:border prose-pre:border-borde prose-code:before:content-none prose-code:after:content-none prose-code:font-normal mt-10 max-w-3xl">
    <Content />
  </div>

  {actualizado && (
    <p class="text-tenue mt-10 text-sm">
      <time datetime={actualizado.toISOString().slice(0, 10)}>
        {formato.format(actualizado)}
      </time>
    </p>
  )}
</Base>
